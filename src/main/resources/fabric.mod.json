{
  "schemaVersion": 1,
  "id": "markscription",
  "version": "${version}",
  "name": "Markscription",
  "license": "MIT",
  "icon": "assets/markscription/icon.png",
  "description": "Markdown for written books, on clients and when signing on servers.",
  "authors": [
    "JulieISBaka"
  ],
  "environment": "*",
  "entrypoints": {
    "client": [
      "org.JulieISBaka.markscription.client.ClientSettings"
    ],
    "modmenu": [
      "org.JulieISBaka.markscription.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "markscription.mixins.json",
    {
      "config": "markscription.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": ">=21.0.0",
    "cloth-config": ">=26.3.159"
  }
}